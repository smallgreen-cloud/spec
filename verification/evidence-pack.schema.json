{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smallgreen-cloud/spec/schemas/evidence-pack.schema.json",
  "title": "SmallGreen Evidence Pack",
  "description": "一次真實驗證部署的 conformance 產物。append-only（EP-2）；不含任何使用者識別欄位（EP-3）；統計對象是專案，永遠不是使用者。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_version", "project_id", "submitted_at", "deploy_event", "code_metrics", "conformance", "low_carbon", "free_tier"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.[1234]\\.\\d+$" },
    "maturity_reached": {
      "type": "string",
      "enum": ["D1", "D2", "D3", "D4", "D4-degraded", "D5a", "D5b"],
      "description": "v0.3（issue #7）：本次驗證達到的部署成熟度（裁判判級，映射規則見研究線 maturity-model）。D1 Buildable／D2 Deployable（URL 200）／D3 Operational／D4 Functionally Valid（驗收全過）／D4-degraded（降級後驗收過）／D5a Removable（teardown 歸零）／D5b Update-Survivable。社群用途＝服務卡顯示驗證深度（只 build 過 vs 功能驗收過 vs 拆得乾淨），EP-4 已審"
    },
    "spec_version": { "type": "string", "description": "驗證當時的 spec 版本（過期判定依據）" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "對應服務卡 id" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string", "description": "更正時指向被取代的 Pack 檔名（EP-2）；被指向的 Pack 保留不刪" },
    "unverified_scope": {
      "type": "array",
      "description": "v0.4（issue #10）：本次驗證**未涵蓋**的面向。未驗不是驗收結果而是範圍界定——記 pass 是灌水、記 fail 是誣賴，故獨立於 user_acceptance。社群用途：服務卡顯示「驗證覆蓋範圍」，讀者可判斷徽章的實際含金量",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "reason"],
        "properties": {
          "surface": { "type": "string", "description": "未驗的面向（如「Google 登入流程」「登入後卡片牆」）" },
          "reason": { "type": "string", "description": "為何不可驗" },
          "blocker_kind": {
            "type": "string",
            "enum": ["external-dependency", "requires-human", "platform-limit", "cost", "other"],
            "description": "external-dependency＝需外部服務帳號；requires-human＝需真人互動；platform-limit＝平台限制"
          }
        }
      }
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_handle": { "type": "string", "description": "自願提供；可整個省略 submitter 匿名提交" }
      }
    },
    "deploy_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "profile", "path", "result"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "profile": { "type": "string", "enum": ["small-app", "pipeline", "small-app+pipeline"] },
        "path": { "type": "string", "enum": ["A-template", "B-retrofit", "C-adapter"], "description": "套用路徑" },
        "result": { "type": "string", "enum": ["success", "failed"] },
        "failure_note": { "type": "string", "description": "失敗也提交——失敗案例是 spec 回饋迴圈的燃料" }
      }
    },
    "code_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loc", "dependency_count", "measured_at_commit"],
      "properties": {
        "loc": { "type": "integer", "minimum": 0 },
        "dependency_count": { "type": "integer", "minimum": 0 },
        "measured_at_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tool": { "type": "string", "description": "測量工具（如 cloc、tokei）" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "result"],
      "properties": {
        "minutes": { "type": "number", "minimum": 0, "description": "CI 執行分鐘數（免費額度實測）" },
        "result": { "type": "string", "enum": ["pass", "fail", "not-run"] },
        "ci_run_url": { "type": "string", "format": "uri" }
      }
    },
    "low_carbon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_to_zero", "green_compute", "no_idle_infra"],
      "properties": {
        "scale_to_zero": { "type": "boolean" },
        "green_compute": { "type": "boolean", "description": "驗證帳號實測 Green Compute 設定" },
        "no_idle_infra": { "type": "boolean" }
      }
    },
    "free_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade"],
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "quota_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agent_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "model", "version", "result", "human_interventions", "stuck_state", "date"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["deployer", "verifier"],
            "default": "deployer",
            "description": "v0.2（issue #5）：矩陣分工。deployer＝照 AGENTS.md 部署；verifier＝不部署、獨立驗證既有部署（result: autonomous＝獨立完成驗證）。服務卡徽章據此分「誰裝得起來」與「誰驗過」"
          },
          "agent": { "type": "string", "description": "如 claude-code、codex、agy、opencode" },
          "model": { "type": "string" },
          "version": { "type": "string" },
          "result": { "type": "string", "enum": ["autonomous", "assisted", "blocked"] },
          "human_interventions": { "type": "integer", "minimum": 0 },
          "stuck_state": { "type": ["string", "null"], "description": "卡關的狀態機狀態；未卡填 null。弱 agent 卡關位置＝spec bug 訊號" },
          "retries": { "type": "integer", "minimum": 0, "maximum": 3, "description": "retry budget 上限 3（EP-7）" },
          "self_repairs": {
            "type": "array",
            "description": "v0.4（issue #12）：agent 自主執行的環境修復。**修了必須記**——未記錄的修復會讓 Pack 顯示「一次過關」而掩蓋專案缺陷，使驗證紀錄無法反映乾淨環境的真實體驗。亦為 profile.build_requirements 的資料來源（issue #13）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "reason"],
              "properties": {
                "action": { "type": "string", "description": "實際執行的修復（如 npm i --save-dev @types/node）" },
                "reason": { "type": "string", "description": "觸發修復的失敗現象" },
                "kind": {
                  "type": "string",
                  "enum": ["missing-dev-dependency", "generate-types", "missing-tool", "transient-retry", "other"],
                  "description": "修復類型；不得用於服務邏輯或契約變更（AGT-2 禁止項）"
                }
              }
            }
          },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "network_behavior_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_domains", "observed_domains", "undeclared", "verdict"],
      "properties": {
        "declared_domains": { "type": "array", "items": { "type": "string" } },
        "observed_domains": { "type": "array", "items": { "type": "string" }, "description": "靜態掃描＋沙盒動態攔截實測" },
        "undeclared": { "type": "array", "items": { "type": "string" } },
        "verdict": { "type": "string", "enum": ["pass", "fail", "human_approved"] },
        "human_ruling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "note"],
          "properties": {
            "by": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "undeclared": { "minItems": 1 } } },
          "then": { "properties": { "verdict": { "enum": ["fail", "human_approved"] } } }
        },
        {
          "if": { "properties": { "verdict": { "const": "human_approved" } } },
          "then": { "required": ["declared_domains", "observed_domains", "undeclared", "verdict", "human_ruling"] }
        }
      ]
    },
    "screenshots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_png": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "tool": { "type": "string", "description": "如 shot-scraper（dogfooding）" }
          }
        },
        "architecture_svg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "generated_from"],
          "properties": {
            "path": { "type": "string" },
            "generated_from": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "生成來源 profile.yaml 所在 commit" }
          }
        }
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "pass", "residual_resources", "date"],
      "properties": {
        "performed": { "type": "boolean" },
        "pass": { "type": "boolean", "description": "資源歸零 diff 為空＝true；殘留＝uninstall 流程 bug＝spec 回饋" },
        "residual_resources": { "type": "array", "items": { "type": "string" } },
        "method": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "user_acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "result", "date"],
        "properties": {
          "task": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail"] },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "verifier_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "usable", "note"],
      "description": "體驗判讀（VER-2.7）：機械閘擋不了好不好用，這欄只能人填",
      "properties": {
        "by": { "type": "string" },
        "usable": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
