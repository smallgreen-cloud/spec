{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smallgreen-cloud/spec/schemas/profile.schema.json",
  "title": "SmallGreen profile.yaml",
  "description": "部署前判定層契約。資源宣告一律看 wrangler 設定（唯一真相源），本檔刻意不提供資源欄位（CON-2）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "summary", "data", "secrets", "external_services"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[12]\\.\\d+$",
      "description": "本檔遵循的契約 schema 版本（0.1.x 契約於 0.2 下仍有效——v0.2 全為 additive 變更）"
    },
    "profile": {
      "type": "string",
      "enum": ["small-app", "pipeline", "small-app+pipeline"],
      "description": "宣告受哪個 Profile 判定（雙平台整合專案宣告複合值，兩檔各自出報告）"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "audience", "users_estimate"],
      "properties": {
        "purpose": { "type": "string", "maxLength": 200, "description": "一句話用途（給一般使用者看，非技術描述）" },
        "audience": { "type": "string", "maxLength": 200 },
        "users_estimate": { "type": "string", "description": "預期使用人數，如 1-10" }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "description": "Path C 適配 repo 必填；須與 UPSTREAM.md 一致（CON-6）",
      "properties": {
        "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string" }
      }
    },
    "login_method": {
      "type": "string",
      "enum": ["none", "email-otp", "github-oauth", "cloudflare-access", "token", "other"],
      "description": "登入方式；other 需在 data.notes 說明"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "stored_in"],
      "properties": {
        "types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "儲存的資料類型（如 contacts、notes、images）"
        },
        "stored_in": {
          "type": "array",
          "items": { "type": "string", "enum": ["d1", "kv", "r2", "analytics_engine", "repo", "issues", "none"] },
          "minItems": 1,
          "description": "v0.2（issue #6）：增 analytics_engine（AE 型服務的事件儲存，90 天滾動保留）"
        },
        "notes": { "type": "string" }
      }
    },
    "secrets": {
      "type": "array",
      "description": "secrets manifest（SAP-3／PIP-4）。空陣列＝明示零 secret，缺欄位＝schema fail",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "required", "how_to_obtain"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "purpose": { "type": "string", "maxLength": 200 },
          "required": { "type": "boolean" },
          "how_to_obtain": { "type": "string", "description": "一般使用者可照做的取得步驟或文件連結" },
          "free_tier": { "type": "boolean", "description": "該外部服務是否有免費層" }
        }
      }
    },
    "external_services": {
      "type": "array",
      "description": "runtime 會連線的宣告外部服務（SAP-5／PIP-7 行為分析器 diff 基準）。空陣列＝宣告零外連",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "purpose", "data_sent"],
        "properties": {
          "domain": { "type": "string", "description": "kind=fixed 時為真域名（萬用字元僅允許最左標籤）；kind 為 user-directed/user-configured 時為標示字串（如 (user-directed)）" },
          "kind": {
            "type": "string",
            "enum": ["fixed", "user-directed", "user-configured"],
            "default": "fixed",
            "description": "v0.2（issue #1）：fixed＝固定域名，行為分析器 diff 直接比對；user-directed＝目標由使用者輸入決定（連結預覽類），驗「不夾帶服務憑證」；user-configured＝目標由部署者設定（webhook 類），驗「預設關閉」。非 fixed 類需人工裁決背書"
          },
          "purpose": { "type": "string", "maxLength": 200 },
          "data_sent": { "type": "string", "description": "送出什麼資料（信任揭露核心欄位）" }
        }
      }
    },
    "resource_usage": {
      "type": "array",
      "description": "v0.2（issue #3）：wrangler 宣告資源的必用／選配標注；未列者視為必用。SVC-4 免費等級判定據此區分",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "required", "feature"],
        "properties": {
          "resource": { "type": "string", "description": "allowlist 資源鍵，如 workers_ai" },
          "required": { "type": "boolean" },
          "feature": { "type": "string", "maxLength": 200, "description": "選配時對應哪個功能（不啟用會少什麼）" }
        }
      }
    },
    "alt_deployment": {
      "type": "array",
      "description": "v0.2（issue #4）：repo 內存在的替代部署路徑揭露（Dockerfile/terraform 等）。SAP-4 改為：常駐基礎設施檔存在但未在此揭露＝fail；已揭露＝pass＋服務卡標注",
      "items": { "type": "string", "enum": ["docker", "docker-compose", "terraform", "procfile", "kubernetes", "other"] }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_minutes_per_run"],
      "description": "profile 含 pipeline 時必填（PIP-3）",
      "properties": {
        "estimated_minutes_per_run": { "type": "number", "minimum": 0 },
        "schedule_note": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "enum": ["pipeline", "small-app+pipeline"] } } },
      "then": { "required": ["schema_version", "profile", "summary", "data", "secrets", "external_services", "pipeline"] }
    }
  ]
}
