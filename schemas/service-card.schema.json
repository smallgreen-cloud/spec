{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smallgreen-cloud/spec/schemas/service-card.schema.json",
  "title": "SmallGreen service card",
  "description": "registry 服務卡。registry YAML＝真相源，目錄站只 render。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "one_liner", "categories", "profile", "repo", "verification", "free_tier_grade", "low_carbon", "maintenance_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "maxLength": 80 },
    "one_liner": { "type": "string", "maxLength": 120, "description": "一句話 use case，寫給一般人，非技術描述" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "值必須存在於 registry taxonomy.yaml（SVC-7，引用完整性由 registry CI 驗）"
    },
    "profile": { "type": "string", "enum": ["small-app", "pipeline", "small-app+pipeline"] },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream"],
      "properties": {
        "upstream": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
        "adapter": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$", "description": "Path C 適配 repo；徽章掛此處不掛上游" },
        "license": { "type": "string" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloudflare": { "type": "array", "items": { "type": "string" } },
        "github": { "type": "array", "items": { "type": "string" } }
      }
    },
    "login_method": { "type": "string" },
    "data_flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_services": { "type": "array", "items": { "type": "string" } },
        "disclosure": { "type": "string", "description": "資料流向一句話揭露（信任信號，卡面顯示）" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "spec_version"],
      "properties": {
        "level": { "type": "string", "enum": ["discovered", "community-verified", "smallgreen-ready"] },
        "spec_version": { "type": "string" },
        "last_verified": { "type": "string", "format": "date" },
        "verifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["github_handle", "date"],
            "properties": {
              "github_handle": { "type": "string" },
              "date": { "type": "string", "format": "date" }
            }
          }
        },
        "evidence_packs": { "type": "array", "items": { "type": "string", "description": "Evidence Pack 檔案路徑或 URL" } },
        "compatible_agents": {
          "type": "array",
          "description": "由 Evidence Pack agent_matrix 聚合，不可手填",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "model", "result"],
            "properties": {
              "agent": { "type": "string" },
              "model": { "type": "string" },
              "result": { "type": "string", "enum": ["autonomous", "assisted", "blocked"] }
            }
          }
        }
      }
    },
    "free_tier_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "機械判定（SVC-4），不可手填與判定值不一致"
    },
    "quota_note": { "type": "string", "description": "grade D 必填：額度上限與監控方式摘要" },
    "low_carbon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_to_zero", "green_compute", "no_idle_infra"],
      "properties": {
        "scale_to_zero": { "type": "boolean" },
        "green_compute": { "type": "boolean" },
        "no_idle_infra": { "type": "boolean" },
        "replaces_vps_estimated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "note"],
          "properties": {
            "value": { "type": "boolean" },
            "note": { "type": "string", "description": "估算情境一句話，引用低碳方法學 v0.1，標明 estimated" }
          }
        }
      }
    },
    "maintenance_status": { "type": "string", "enum": ["active", "slowing", "stalled", "archived", "revived"] },
    "scenario_stories": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story", "author", "date", "reviewed"],
        "properties": {
          "story": { "type": "string", "maxLength": 500, "description": "誰＋情境＋用它做什麼＋之後差在哪（2-3 句）" },
          "author": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "reviewed": { "type": "boolean", "description": "false 不上目錄站（SVC-6）" }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "evidence_pack_ref"],
          "properties": {
            "path": { "type": "string" },
            "evidence_pack_ref": { "type": "string", "description": "必須引用產出它的 Evidence Pack（SVC-8：禁 mockup、禁 AI 生圖）" }
          }
        },
        "architecture_svg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "generated_from"],
          "properties": {
            "path": { "type": "string" },
            "generated_from": { "type": "string", "description": "生成來源 profile.yaml 的 commit hash" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "properties": { "level": { "const": "community-verified" } } } } },
      "then": {
        "properties": {
          "verification": { "required": ["level", "spec_version", "last_verified", "verifiers", "evidence_packs"] },
          "scenario_stories": { "minItems": 1 }
        },
        "required": ["id", "name", "one_liner", "categories", "profile", "repo", "verification", "free_tier_grade", "low_carbon", "maintenance_status", "scenario_stories"]
      }
    },
    {
      "if": { "properties": { "verification": { "properties": { "level": { "const": "smallgreen-ready" } } } } },
      "then": {
        "properties": {
          "verification": { "required": ["level", "spec_version", "last_verified", "verifiers", "evidence_packs", "compatible_agents"] },
          "scenario_stories": { "minItems": 1 }
        },
        "required": ["id", "name", "one_liner", "categories", "profile", "repo", "verification", "free_tier_grade", "low_carbon", "maintenance_status", "scenario_stories"]
      }
    },
    {
      "if": { "properties": { "free_tier_grade": { "const": "D" } } },
      "then": { "required": ["id", "name", "one_liner", "categories", "profile", "repo", "verification", "free_tier_grade", "low_carbon", "maintenance_status", "quota_note"] }
    }
  ]
}
